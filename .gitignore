# Rust
**/target/
# Libraries let downstreams resolve. A comment on a pattern's own line is
# part of the pattern in gitignore, which is how 23 lock files got in.
**/Cargo.lock
# If a Rust CLI binary ever lands here, this exception unlocks it.
!cli/Cargo.lock

# Python bytecode (30 .pyc files had been committed)
**/__pycache__/
*.py[cod]

# Java
**/target/
**/dependency-reduced-pom.xml

# Node (cli/)
**/node_modules/
**/npm-debug.log*
**/pnpm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.iml

# OS
.DS_Store
Thumbs.db

# Secrets - publish tokens, GPG passphrase, Sonatype creds. Only the
# .env.local template is checked in; copy it to .env and fill in the
# real values locally.
.env
.env.*
!.env.local

# Published-deployment tracking. The .staged-deployments.txt file is
# the rolling list of Maven Central deployment IDs awaiting manual
# Publish or dropall; per-host state, never shared.
.scripts/.staged-deployments.txt
.scripts/.staged-crates.txt

# crates.io publish backup (cargo writes .crate next to Cargo.toml on publish)
**/*.crate

# Build artefacts that should never land
**/*.log
**/*.tmp

# Internal dev guidance (imports the private subms-specs golden) - never ship publicly
CLAUDE.md
.design/

# Local bench captures (bench-local.mjs) - never the official fleet perf/,
# and the run-level report artifacts (BENCH_REPORT.{md,json}) now under the
# cookbook-root local scratch dir.
recipes/**/.subms/local/
/.subms/local/
BENCH_LOCAL_REVIEW.*
BENCH_LOCAL*.json
# legacy root reports (pre-2026-07-30, before the move to .subms/local/)
/BENCH_REPORT.md
/BENCH_REPORT.json
BENCH_LOCAL*.md
