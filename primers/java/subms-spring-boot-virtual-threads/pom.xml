<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.submillisecond.primers</groupId>
    <artifactId>subms-spring-boot-virtual-threads</artifactId>
    <version>0.3.0</version>
    <packaging>jar</packaging>

    <name>subms-spring-boot-virtual-threads</name>
    <description>submillisecond.com cookbook primer - concurrency: subms-spring-boot-virtual-threads. Spring Boot 4 with virtual threads enabled - measure how a fan-out endpoint behaves under concurrent load. Toggleable so the same workload runs on the platform-thread pool for comparison.</description>
    <url>https://submillisecond.com</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <java.version>21</java.version>
    </properties>

    <!--
        Spring Boot 4.0.6 (latest stable at time of writing) brings
        Spring Framework 7 and embedded Tomcat 11. Virtual threads are
        enabled through application.properties, not code - the toggle
        sits there so the bench can run with and without.

        Build:    mvn -q package
        Run:      mvn -q spring-boot:run
        Test:     mvn -q test
        LoadGen:  java -cp ... com.submillisecond.primers.springboot.LoadDriver
    -->

    <dependencies>
        <dependency>
            <groupId>com.submillisecond</groupId>
            <artifactId>subms</artifactId>
            <version>0.3.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Spring Boot 4 split the MockMvc test slice out of the umbrella
            starter-test into a per-stack `spring-boot-starter-webmvc-test`.
            That starter pulls in starter-test transitively and adds the
            webmvc-specific autoconfigure classes (@AutoConfigureMockMvc,
            MockMvcAutoConfiguration, etc.) at their new home under
            org.springframework.boot.webmvc.test.autoconfigure.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
