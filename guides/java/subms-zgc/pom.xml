<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.submillisecond.guides</groupId>
    <artifactId>subms-zgc</artifactId>
    <version>0.3.0</version>
    <packaging>jar</packaging>

    <name>subms-zgc</name>
    <description>submillisecond.com cookbook guide - gc: subms-zgc. ZGC in motion - measure application-thread pause times under sustained allocation pressure and compare to G1.</description>
    <url>https://submillisecond.com</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        Zero runtime dependencies - OpenJDK 21 only. ZGC is enabled at
        runtime via -XX:+UseZGC; generational mode via
        -XX:+ZGenerational. The pom doesn't bake in collector choice -
        run the bench under each. JUnit 5 is test-scope and never
        reaches downstream consumers.

        Build:    mvn -q package
        ZGC:      java -XX:+UseZGC -XX:+ZGenerational -Xms2g -Xmx2g \
                       -cp target/classes com.submillisecond.guides.zgc.PauseTimeBench
        G1:       java -XX:+UseG1GC                   -Xms2g -Xmx2g \
                       -cp target/classes com.submillisecond.guides.zgc.PauseTimeBench
        Test:     mvn -q test
    -->

    <dependencies>
        <dependency>
            <groupId>com.submillisecond</groupId>
            <artifactId>subms</artifactId>
            <version>0.3.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
            </plugin>
        </plugins>
    </build>
</project>
