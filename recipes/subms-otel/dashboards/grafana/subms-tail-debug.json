{
  "uid": "subms-tail-debug",
  "title": "subms - tail debug (exemplars)",
  "description": "Heatmaps + exemplar tables for chasing the slowest sampled ops. Pair with a tracing backend so the exemplar trace_id links resolve.",
  "tags": ["subms", "perf", "exemplars", "tail-latency", "submillisecond"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "recipe",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(subms_latency_seconds_count, subms_recipe_slug)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "stage",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(subms_latency_seconds_count{subms_recipe_slug=~\"$recipe\"}, subms_stage)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "heatmap",
      "title": "Latency heatmap (subms_latency_seconds_bucket)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "exponent": 0.5,
          "fill": "dark-orange",
          "mode": "scheme",
          "scale": "exponential",
          "scheme": "Spectral",
          "steps": 64
        },
        "exemplars": { "color": "rgba(255,0,255,0.7)" },
        "filterValues": { "le": 1e-9 },
        "legend": { "show": true },
        "rowsFrame": { "layout": "auto" },
        "tooltip": { "show": true, "yHistogram": true },
        "yAxis": { "axisPlacement": "left", "unit": "s", "reverse": false }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": { "tooltip": false, "viz": false, "legend": false },
            "scaleDistribution": { "type": "linear" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(subms_latency_seconds_bucket{subms_recipe_slug=~\"$recipe\", subms_stage=~\"$stage\"}[1m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p50 / p99 / p999 / max (selected stage)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 4
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.001 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(subms_latency_seconds_bucket{subms_recipe_slug=~\"$recipe\", subms_stage=~\"$stage\"}[5m])))",
          "legendFormat": "p50",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(subms_latency_seconds_bucket{subms_recipe_slug=~\"$recipe\", subms_stage=~\"$stage\"}[5m])))",
          "legendFormat": "p99",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.999, sum by (le) (rate(subms_latency_seconds_bucket{subms_recipe_slug=~\"$recipe\", subms_stage=~\"$stage\"}[5m])))",
          "legendFormat": "p999",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "exemplars kept/sec (per-bucket reservoir top-ups)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (subms_stage) (rate(subms_otel_exemplars_kept_total{subms_recipe_slug=~\"$recipe\", subms_stage=~\"$stage\"}[1m]))",
          "legendFormat": "{{subms_stage}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Slowest sampled ops (exemplars with trace_id)",
      "description": "Reads exemplars off the subms_latency_seconds_bucket series. Click trace_id to jump to the linked trace in your tracing data source.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "align": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "trace_id" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View trace",
                    "url": "/explore?left=%7B%22datasource%22:%22tempo%22,%22queries%22:%5B%7B%22query%22:%22${__value.raw}%22%7D%5D%7D",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          { "displayName": "Value", "desc": true }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": false,
          "exemplar": true,
          "expr": "topk(20, max_over_time(subms_latency_seconds_bucket{subms_recipe_slug=~\"$recipe\", subms_stage=~\"$stage\"}[5m]))",
          "legendFormat": "",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    }
  ]
}
